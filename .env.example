DATABASE_URL=postgresql://apicanary:apicanary@localhost:5432/apicanary
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
ALERT_FROM_EMAIL=alerts@example.com

# Generate a unique value with: openssl rand -base64 48
SECRET_KEY=replace-with-a-unique-secret-of-at-least-32-characters
# Optional separate key so JWT rotation does not affect stored monitor headers.
MONITOR_ENCRYPTION_KEY=replace-with-another-unique-secret
ENVIRONMENT=development
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

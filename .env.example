DATABASE_URL=postgresql://apicanary:apicanary@localhost:5432/apicanary
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
ALERT_FROM_EMAIL=alerts@example.com
PUBLIC_APP_URL=http://localhost:3000
SMTP_TIMEOUT_SECONDS=10
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_AUTH_REQUIRED=true

# Notification jobs use exponential backoff and remain recoverable if Redis is
# temporarily unavailable.
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=900
NOTIFICATION_DELIVERY_LEASE_SECONDS=600

# Generate a unique value with: openssl rand -base64 48
SECRET_KEY=replace-with-a-unique-secret-of-at-least-32-characters
# Optional separate key so JWT rotation does not affect stored monitor headers.
MONITOR_ENCRYPTION_KEY=replace-with-another-unique-secret
ENVIRONMENT=development
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
